{
  "name": "Academic Minimalism × Premium Product UI",
  "colors": {
    "background": "#FFFFFF",
    "surface": "#F7F7F7",
    "surfaceSubtle": "#FAFAFA",
    "textPrimary": "#111111",
    "textSecondary": "#4C4C4E",
    "border": "#DADADC",
    "borderSubtle": "#ECECEE",
    "accent": "#4C4C4E",
    "accentHover": "#262628",
    "inverseBackground": "#1A1A1C",
    "inverseText": "#FFFFFF"
  },
  "typography": {
    "family": "Inter, ui-sans-serif, system-ui, sans-serif",
    "hero": "clamp(4rem, 10vw, 7.75rem)",
    "section": "clamp(2.5rem, 5vw, 4.5rem)",
    "body": "clamp(1rem, 1.2vw, 1.125rem)",
    "weights": {"regular": 400, "medium": 500, "semibold": 600}
  },
  "spacing": {
    "sectionDesktop": "clamp(6rem, 11vw, 10rem)",
    "sectionMobile": "5rem",
    "containerGutter": "clamp(1.25rem, 4vw, 3rem)"
  },
  "radius": {"button": "12px", "card": "18px", "small": "10px"},
  "shadow": {"hover": "0 18px 50px rgba(17,17,17,.08)"},
  "motion": {
    "fast": "180ms",
    "normal": "320ms",
    "slow": "650ms",
    "ease": "cubic-bezier(.22, 1, .36, 1)"
  },
  "layout": {
    "container": "1280px",
    "textMeasure": "68ch",
    "headerHeight": "72px",
    "breakpoints": ["390px", "430px", "768px", "1024px", "1440px"]
  }
}
